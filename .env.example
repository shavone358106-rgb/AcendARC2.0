# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Exchange (Binance paper / live) ──────────────────────────────────────────
EXCHANGE=binance
EXCHANGE_API_KEY=your_exchange_api_key
EXCHANGE_API_SECRET=your_exchange_api_secret
EXCHANGE_SANDBOX=true          # set false to go live

# ── Risk parameters ────────────────────────────────────────────────────────────
MAX_POSITION_SIZE_PCT=0.02     # 2% per trade
DAILY_LOSS_LIMIT_PCT=0.05      # 5% daily stop
MAX_DRAWDOWN_PCT=0.15          # 15% kill switch
MIN_CONFIDENCE=1.5             # minimum strategy confidence score

# ── Telegram notifications ─────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=           # optional
TELEGRAM_CHAT_ID=             # optional

# ── Trading pairs ──────────────────────────────────────────────────────────────
SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT

# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosync:///./data/trading_agent.db

# ── Logging ────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
RESULTS_DIR=./results
